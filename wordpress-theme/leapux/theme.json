{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "palette": [
        { "slug": "black", "color": "#000000", "name": "Black" },
        { "slug": "white", "color": "#ffffff", "name": "White" },
        { "slug": "light", "color": "#F6F7F9", "name": "Light Gray" },
        { "slug": "orange", "color": "#e8812f", "name": "LeapUX Orange" },
        { "slug": "brand", "color": "#a65d1a", "name": "LeapUX Brand" },
        { "slug": "red", "color": "#d04a2a", "name": "LeapUX Red" },
        { "slug": "slate-300", "color": "#cbd5e1", "name": "Slate 300" },
        { "slug": "slate-400", "color": "#94a3b8", "name": "Slate 400" },
        { "slug": "slate-500", "color": "#64748b", "name": "Slate 500" },
        { "slug": "slate-600", "color": "#475569", "name": "Slate 600" },
        { "slug": "border", "color": "#e2e8f0", "name": "Border" }
      ],
      "gradients": [
        {
          "slug": "orange-to-red",
          "gradient": "linear-gradient(135deg, #e8812f 0%, #d04a2a 100%)",
          "name": "Orange to Red"
        }
      ],
      "defaultPalette": false,
      "defaultGradients": false
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
          "slug": "inter",
          "name": "Inter",
          "fontFace": [
            {
              "fontFamily": "Inter",
              "fontWeight": "300",
              "fontStyle": "normal",
              "src": ["file:./assets/fonts/inter-v18-latin-300.woff2"]
            },
            {
              "fontFamily": "Inter",
              "fontWeight": "400",
              "fontStyle": "normal",
              "src": ["file:./assets/fonts/inter-v18-latin-regular.woff2"]
            },
            {
              "fontFamily": "Inter",
              "fontWeight": "500",
              "fontStyle": "normal",
              "src": ["file:./assets/fonts/inter-v18-latin-500.woff2"]
            },
            {
              "fontFamily": "Inter",
              "fontWeight": "600",
              "fontStyle": "normal",
              "src": ["file:./assets/fonts/inter-v18-latin-600.woff2"]
            },
            {
              "fontFamily": "Inter",
              "fontWeight": "700",
              "fontStyle": "normal",
              "src": ["file:./assets/fonts/inter-v18-latin-700.woff2"]
            },
            {
              "fontFamily": "Inter",
              "fontWeight": "900",
              "fontStyle": "normal",
              "src": ["file:./assets/fonts/inter-v18-latin-900.woff2"]
            }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "xs", "size": "0.625rem", "name": "Extra Small" },
        { "slug": "small", "size": "0.875rem", "name": "Small" },
        { "slug": "medium", "size": "1rem", "name": "Medium" },
        { "slug": "large", "size": "1.125rem", "name": "Large" },
        { "slug": "xl", "size": "1.25rem", "name": "Extra Large" },
        { "slug": "2xl", "size": "1.875rem", "name": "2XL" },
        { "slug": "3xl", "size": "2.25rem", "name": "3XL" },
        { "slug": "4xl", "size": "3rem", "name": "4XL" },
        { "slug": "5xl", "size": "4.5rem", "name": "5XL" }
      ]
    },
    "spacing": {
      "units": ["px", "em", "rem", "%", "vw", "vh"],
      "spacingSizes": [
        { "slug": "10", "size": "0.5rem", "name": "XS" },
        { "slug": "20", "size": "1rem", "name": "S" },
        { "slug": "30", "size": "1.5rem", "name": "M" },
        { "slug": "40", "size": "2rem", "name": "L" },
        { "slug": "50", "size": "3rem", "name": "XL" },
        { "slug": "60", "size": "4rem", "name": "2XL" },
        { "slug": "70", "size": "6rem", "name": "3XL" },
        { "slug": "80", "size": "8rem", "name": "4XL" }
      ]
    },
    "layout": {
      "contentSize": "800px",
      "wideSize": "1280px"
    },
    "border": {
      "radius": true,
      "color": true,
      "style": true,
      "width": true
    },
    "custom": {
      "spacing": {
        "section": "8rem"
      },
      "borderRadius": {
        "small": "0.5rem",
        "medium": "1rem",
        "large": "1.5rem",
        "xl": "2rem"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--white)",
      "text": "var(--wp--preset--color--black)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.6"
    },
    "spacing": {
      "blockGap": "0"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--inter)",
          "fontWeight": "700",
          "lineHeight": "1.1"
        },
        "color": {
          "text": "var(--wp--preset--color--black)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "clamp(3rem, 6vw, 5rem)",
          "letterSpacing": "-0.02em"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "clamp(1.875rem, 4vw, 2.5rem)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "clamp(1.5rem, 3vw, 2rem)"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "1.25rem"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--orange)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--brand)"
          }
        }
      },
      "button": {
        "typography": {
          "fontSize": "0.75rem",
          "fontWeight": "700",
          "textTransform": "uppercase",
          "letterSpacing": "0.15em"
        },
        "color": {
          "background": "var(--wp--preset--color--orange)",
          "text": "var(--wp--preset--color--white)"
        },
        "border": {
          "radius": "9999px"
        },
        "spacing": {
          "padding": {
            "top": "1.25rem",
            "bottom": "1.25rem",
            "left": "2.5rem",
            "right": "2.5rem"
          }
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--brand)"
          }
        }
      }
    },
    "blocks": {
      "core/navigation": {
        "typography": {
          "fontSize": "0.6875rem",
          "fontWeight": "700",
          "textTransform": "uppercase",
          "letterSpacing": "0.2em"
        }
      },
      "core/separator": {
        "color": {
          "text": "var(--wp--preset--color--border)"
        },
        "border": {
          "width": "1px"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "front-page",
      "title": "Front Page",
      "postTypes": ["page"]
    }
  ],
  "patterns": [
    "leapux/hero",
    "leapux/about",
    "leapux/services",
    "leapux/work",
    "leapux/testimonials",
    "leapux/contact"
  ]
}
